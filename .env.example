# --- Site ---
# Public origin, used for canonical and share URLs. Defaults to https://djdn.com.
NEXT_PUBLIC_SITE_URL=

# --- Sanity ---
# Create a project at https://sanity.io/manage, then copy its ID here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token for draft mode / writes (Editor or Viewer role).
# Leave unset for read-only published content via the CDN.
SANITY_API_READ_TOKEN=

# --- Returns form (emails each request to the business) ---
# Free account at https://resend.com, then API Keys. Until it is set, the form
# only prints requests in the terminal during development, and shows a
# "contact us directly" message in production.
RESEND_API_KEY=
# Where requests land. Defaults to the support email in lib/site.ts.
RETURNS_TO_EMAIL=
# Sender. Defaults to Resend's test address, which only delivers to the email
# you signed up to Resend with. Once a domain is verified, use e.g.
# "DJDN Returns <returns@yourdomain.com>".
RETURNS_FROM_EMAIL=

# --- Supabase (accounts, orders) ---
# Create a project at https://supabase.com, then Project Settings > API.
# Until these are set, /account stays on its "coming soon" page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the Flutterwave webhook to mark orders paid. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Flutterwave (checkout — wired up in a later step, keep in test mode) ---
NEXT_PUBLIC_FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_SECRET_HASH=
